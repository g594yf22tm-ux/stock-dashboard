{
  "name": "a-stock-dashboard",
  "version": "5.0.0",
  "description": "A股实时行情仪表盘 — 新浪财经数据源 · 10板块覆盖 · 24/7在线",
  "main": "dashboard/server.js",
  "scripts": {
    "start": "node dashboard/server.js",
    "dashboard": "node dashboard/server.js",
    "dashboard:live": "node scripts/fetch-sina-data.js && node dashboard/server.js",
    "dashboard:fetch": "node scripts/fetch-sina-data.js",
    "dashboard:build": "node dashboard/server.js --build",
    "dashboard:dev": "node --watch dashboard/server.js",
    "screenshot": "node scripts/resize-screenshot.js && node scripts/ocr-screenshot.js",
    "screenshot:compress": "node scripts/resize-screenshot.js",
    "screenshot:ocr": "node scripts/ocr-screenshot.js",
    "init": "node scripts/init-dashboard-data.js",
    "tunnel": "node scripts/tunnel.js",
    "share": "node dashboard/server.js & node scripts/tunnel.js",
    "deploy": "node scripts/deploy-cloud.js",
    "test": "node -e \"try{require('./dashboard/services/sinaApi');require('./dashboard/server.js'.replace('server.js','services/sinaApi'));console.log('✅ 所有模块加载正常')}catch(e){console.log('❌',e.message)}\""
  },
  "keywords": ["A股", "股票", "仪表盘", "实时行情", "新浪财经"],
  "author": "AI股票分析团队",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "localtunnel": "^2.0.2",
    "pinyin-pro": "^3.28.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "yahoo-finance2": "^2.14.0"
  }
}
