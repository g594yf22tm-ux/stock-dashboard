# ============================================================
# Stock Dashboard — Environment Variables
# ============================================================
# Copy this file to dashboard/.env and fill in your keys.
# dashboard/.env is gitignored — never commit real keys.
# ============================================================

# Financial Modeling Prep API Key
# Free tier: 250 requests/day. Register at https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_api_key_here

# Dashboard server port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info
